{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src/server",
    "outDir": "dist/server",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/server"],
  "exclude": ["src/server/**/*.test.ts"]
}
